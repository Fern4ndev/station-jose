# Copiar a .env y completar los valores reales. Este archivo sí se versiona.

ENTORNO=desarrollo

# Aplicación: permisos mínimos (SELECT/INSERT donde corresponda).
DATABASE_URL=postgresql+asyncpg://vales_app:cambiar_esta_clave@127.0.0.1:5432/sanjose
DATABASE_URL_TEST=postgresql+asyncpg://vales_app:cambiar_esta_clave@127.0.0.1:5432/sanjose_test

# Migraciones: dueño de la estructura y los disparadores.
MIGRADOR_URL=postgresql+asyncpg://vales_migrador:cambiar_esta_clave@127.0.0.1:5432/sanjose
MIGRADOR_URL_TEST=postgresql+asyncpg://vales_migrador:cambiar_esta_clave@127.0.0.1:5432/sanjose_test

OCR_DEVICE=cpu
ALMACENAMIENTO_DIR=almacenamiento
FRONTEND_DIST=../dist/frontend/browser

JWT_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
# Umbral de score de reCAPTCHA v3 (0.5) y el `hostname` esperado si difiere del host.
RECAPTCHA_UMBRAL_MINIMO=0.5
RECAPTCHA_HOSTNAME=

# Sesión: vida del access JWT y del token de recuperación.
ACCESS_TOKEN_MINUTOS=10
RECUPERACION_TOKEN_MINUTOS=15
# Dominio del frontend para el enlace del correo de recuperación (con https:// o http://).
FRONTEND_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
